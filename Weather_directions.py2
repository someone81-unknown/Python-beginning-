user_input=input("""what's the weather?
1)hot
2)cold 
3)normal
 """)
 
mosam=user_input.split(" ")


def haal(user_input):
	weather={"normal":"good",
"cold":"don't forget warm clothes",
"hot":"stay inside sir",
"1":"good",
"2":"don't forget warm clothes",
"3":"stay inside sir"
	}
	output=""
	for x in mosam:
		output+=weather.get(x, x)+" "
		return output


print(haal(user_input))
